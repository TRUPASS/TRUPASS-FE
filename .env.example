# 백엔드(Spring Boot) 주소. VITE_USE_MOCK=false 일 때 실제로 호출된다.
VITE_API_BASE_URL=http://localhost:8080
# true 이면 MSW 브라우저 워커가 API 를 가로채 Mock 응답을 돌려준다 (Google 로그인도 Mock 으로 한다).
VITE_USE_MOCK=true
# Google 로그인 버튼의 OAuth 클라이언트 ID(공개 값). 백엔드 GOOGLE_OAUTH_CLIENT_IDS 에 든 값과 같아야 한다.
# Google Cloud Console 의 그 클라이언트 ID 에 "승인된 JavaScript 원본"으로 http://localhost:5173 을 넣어 둔다.
# 실제 백엔드로 로그인하려면 VITE_USE_MOCK=false 로 바꾼다. 둘 다 비우면 로그인 없이 화면만 이어 본다.
VITE_GOOGLE_CLIENT_ID=
# 토스페이먼츠 "클라이언트 키"(브라우저 공개 키)만 넣는다. 시크릿 키는 절대 FE 에 두지 않는다.
VITE_TOSS_CLIENT_KEY=
